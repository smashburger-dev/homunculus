#!/bin/sh
# Blocks pushes that would publish personal health data or secrets.
# Scans the tree of every commit the remote does not have yet, so a secret
# added in one commit and removed in the next is still caught.
# Enable once per clone: git config core.hooksPath .githooks
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
cd "$(git rev-parse --show-toplevel)" || exit 1
remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue  # branch deletion
  known=""
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    known="$remote_sha"
  fi
  commits=$(git rev-list "$local_sha" --not $known --remotes="$remote") || {
    echo "pre-push: git rev-list failed for $local_ref, refusing" >&2
    exit 1
  }
  for commit in $commits; do
    python3 tools/leak_guard.py --rev "$commit" </dev/null >/dev/null || {
      echo "pre-push: commit $commit ($local_ref -> $remote_ref) blocked" >&2
      status=1
    }
  done
done
exit $status
